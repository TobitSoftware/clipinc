{
    "author": "Tobit.Software",
    "background": {
        "service_worker": "background-page/background.js"
    },
    "action": {
        "default_icon": {
            "16": "assets/images/clipinc-16.png",
            "32": "assets/images/clipinc-32.png",
            "48": "assets/images/clipinc-48.png",
            "128": "assets/images/clipinc-128.png"
        },
        "default_popup": "popup/index.html"
    },
    "content_scripts": [
        {
            "js": ["content/inject.js"],
            "matches": ["https://open.spotify.com/*"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "css": ["content/slider.css"],
            "js": ["content/content.js"],
            "matches": ["https://open.spotify.com/*"],
            "run_at": "document_start"
        }
    ],
    "default_locale": "de",
    "description": "__MSG_description__",
    "icons": {
        "16": "assets/images/clipinc-16.png",
        "32": "assets/images/clipinc-32.png",
        "48": "assets/images/clipinc-48.png",
        "128": "assets/images/clipinc-128.png"
    },
    "manifest_version": 3,
    "name": "__MSG_name__",
    "permissions": [
        "tabs",
        "tabCapture",
        "activeTab",
        "storage",
        "downloads",
        "notifications",
        "offscreen",
        "declarativeNetRequestWithHostAccess"
    ],
    "version": "1.12.12",
    "minimum_chrome_version": "116",
    "host_permissions": ["https://musicbrainz.org/*"]
}
