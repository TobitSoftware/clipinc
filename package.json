{
    "name": "clipinc",
    "version": "1.12.12",
    "description": "clipinc chrome browser extension to record spotify songs",
    "repository": {
        "type": "git",
        "url": "https://github.com/TobitSoftware/clipinc"
    },
    "license": "MIT",
    "author": "Tobit Software",
    "scripts": {
        "build": "chayns-toolkit build",
        "dev": "chayns-toolkit dev",
        "start": "chayns-toolkit dev",
        "format": "prettier . --write",
        "format-staged": "pretty-quick --staged",
        "lint": "chayns-toolkit lint",
        "release": "npm run build && node scripts/bundle.mjs",
        "test": "jest"
    },
    "prettier": {
        "proseWrap": "always",
        "singleQuote": true,
        "tabWidth": 4,
        "printWidth": 100
    },
    "eslintConfig": {
        "extends": "@chayns-toolkit"
    },
    "dependencies": {
        "mp4-muxer": "^5.2.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "styled-components": "^6.1.16"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.310",
        "@types/jest": "^29.5.14",
        "@types/react": "^19.0.12",
        "@types/react-dom": "^19.0.4",
        "archiver": "^7.0.1",
        "chayns-toolkit": "^3.2.6",
        "chrome-launcher": "^1.1.2",
        "husky": "^9.1.7",
        "jest": "^29.6.4",
        "jest-cli": "^29.6.4",
        "prettier": "^3.5.3",
        "prettier-plugin-packagejson": "^2.5.10",
        "pretty-quick": "^3.1.3",
        "puppeteer": "^24.4.0",
        "rimraf": "^6.0.1",
        "shx": "^0.4.0",
        "typescript": "^5.8.2"
    },
    "overrides": {
        "pretty-quick": {
            "prettier": ">=2"
        }
    }
}
