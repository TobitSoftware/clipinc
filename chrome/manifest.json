{
    "author": "Tobit.Software",
    "background": {
        "service_worker": "static/js/background/index.js",
        "scripts": [
            "static/js/background/index.js"
        ]
    },
    "action": {
        "default_icon": {
            "16": "images/clipinc-16.png",
            "32": "images/clipinc-32.png",
            "48": "images/clipinc-48.png",
            "128": "images/clipinc-128.png"
        },
        "default_popup": "popup/index.html"
    },
    "content_scripts": [
        {
            "js": ["static/js/content/content.js"],
            "matches": ["https://open.spotify.com/*"]
        }
    ],
    "default_locale": "de",
    "description": "__MSG_description__",
    "icons": {
        "16": "images/clipinc-16.png",
        "32": "images/clipinc-32.png",
        "48": "images/clipinc-48.png",
        "128": "images/clipinc-128.png"
    },
    "manifest_version": 3,
    "name": "__MSG_name__",
    "permissions": [
        "tabs",
        "tabCapture",
        "activeTab",
        "storage",
        "downloads",
        "downloads.shelf",
        "notifications",
        "offscreen"
    ],
    "version": "1.12.12",
    "web_accessible_resources": [{
        "resources": ["static/js/content/inject.js"],
        "matches": ["https://open.spotify.com/*"]
    }]
}
